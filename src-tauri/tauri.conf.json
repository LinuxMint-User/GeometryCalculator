{
  "$schema": "https://schema.tauri.app/config/",
  "productName": "geometry-calculator",
  "version": "2.5.2",
  "identifier": "io.github.linuxmintuser.geometrycalculator",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:9019",
    "beforeDevCommand": "python3 -m http.server 9019 --directory \"$(git rev-parse --show-toplevel)/frontend\"",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "几何计算器",
        "width": 900,
        "height": 650,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
